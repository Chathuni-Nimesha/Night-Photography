# Copy this file to NIGHTLIFE/.env and fill in local values.
# Do not commit the real .env file.
#
# Backend: http://localhost:5454
# Frontend: http://localhost:3000
# MySQL (XAMPP in this project): localhost:3308
# Database: nightlife

JWT_SECRET=
JWT_EXPIRATION=86400000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DB_HOST=localhost
DB_PORT=3308
DB_NAME=nightlife
DB_USERNAME=root
DB_PASSWORD=
FRONTEND_URL=http://localhost:3000
SERVER_PORT=5454

# Local demo dataset (users/posts/likes/comments/follows). Default: false.
# Enable once, then disable. Idempotent if neonaria@nightlife.demo already exists.
# Demo password for all *@nightlife.demo accounts: DemoNight1!
#
# Prefer command-line enable (does not require editing .env):
#   .\mvnw.cmd spring-boot:run "-Dspring-boot.run.arguments=--nightlife.demo-data.enabled=true"
#
# Or set in the process environment (same place you load JWT_SECRET):
NIGHTLIFE_DEMO_DATA=false

# One-shot refresh of curated media for EXISTING *@nightlife.demo accounts only.
# Does not recreate users or wipe likes/comments/follows. Default: false.
#   .\mvnw.cmd spring-boot:run "-Dspring-boot.run.arguments=--nightlife.demo-data.refresh-media=true"
NIGHTLIFE_DEMO_REFRESH_MEDIA=false
