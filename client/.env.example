# Copy this file to client/.env and fill in local values.
# Do not commit the real .env file.
#
# Frontend: http://localhost:3000
# Backend API: http://localhost:5454

REACT_APP_API_URL=http://localhost:5454

# Cloudinary unsigned upload (browser). Required for image/video uploads.
# There are no hardcoded fallbacks in source — copy this file to .env and fill in.
# Unsigned presets are public upload names, not API secrets. Do not put API secrets here.
REACT_APP_CLOUDINARY_CLOUD_NAME=
REACT_APP_CLOUDINARY_PRESET_IMAGE=
REACT_APP_CLOUDINARY_PRESET_VIDEO=
